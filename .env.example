# ── Database ──
DATABASE_URL="postgresql://catatku:catatku@localhost:5432/catatku"

# ── Auth (Better Auth) ──
# Wajib acak & rahasia di produksi: openssl rand -base64 32
BETTER_AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
BETTER_AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
# Rate limit selalu aktif di production; set "true" untuk mengaktifkan di development
RATE_LIMIT="false"

# ── Email ──
# "false" = akun langsung aktif tanpa verifikasi (khusus development)
EMAIL_VERIFICATION="false"
# console | resend | memory
EMAIL_TRANSPORT="console"
RESEND_API_KEY=""
EMAIL_FROM="Catatku <no-reply@domainmu.com>"

# ── Upload ──
UPLOAD_DIR="./.uploads"
