# ── Database ──
DATABASE_URL="postgresql://catatku:catatku@localhost:5432/catatku"

# ── Auth (Better Auth) ──
# Wajib acak & rahasia di produksi: openssl rand -base64 32
BETTER_AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
BETTER_AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
# Rate limit login selalu aktif di production; set "true" untuk mengaktifkan di development
RATE_LIMIT="false"

# ── Upload foto profil ──
UPLOAD_DIR="./.uploads"
